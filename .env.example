# Copy to .env and fill in as needed. Every variable is read in
# app/config.py; anything left unset falls back to the zero-infrastructure
# local default, so an empty .env still gives a working dev server.

# --- environment identity ---
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                   # true in every non-laptop environment

# --- database ---
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/fraud_detection
# AUTO_CREATE_SCHEMA=false       # migrations only in prod -- see migrations/

# --- media storage ---
# MEDIA_STORAGE_DIR=storage
# MEDIA_RETENTION_DAYS=365       # see app/retention.py for the active-profile protection rule

# --- background jobs ---
# SCAN_DISPATCH=celery
# CELERY_BROKER_URL=redis://localhost:6379/1

# --- rate limiting / caching ---
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_BACKEND=redis       # "memory" (default, single-process only) or "redis"
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE_DEFAULT=120
# RATE_LIMIT_PER_MINUTE_UPLOAD=10

# --- CORS ---
# ALLOWED_ORIGINS=https://fraud-review.example.com   # comma-separated; "*" only valid by default in development

# --- auth (MUST be set before any production traffic) ---
# The default (unset) is the demo header stub (X-User-Id / X-User-Role) --
# see app/auth.py's docstring. It trusts client-supplied identity outright
# and must not reach real traffic.
# AUTH_BACKEND=jwt
# AUTH_JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# AUTH_JWT_AUDIENCE=fake-profile-detection
# AUTH_JWT_ISSUER=https://your-idp.example.com/
# AUTH_JWT_ROLE_CLAIM=role
